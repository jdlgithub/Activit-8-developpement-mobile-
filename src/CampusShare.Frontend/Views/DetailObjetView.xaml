<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:CampusShare.Frontend.Views.Components"
             x:Class="CampusShare.Frontend.Views.DetailObjetView"
             Title="Detail de l objet">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="{Binding Titre}" Style="{StaticResource TitreEcran}" />
            <Label Text="{Binding Objet.Titre}" FontSize="20" FontAttributes="Bold" />
            <Label Text="{Binding Objet.Categorie}" Style="{StaticResource SousTitre}" />
            <Label Text="{Binding Objet.Description}" />
            <Label Text="{Binding Objet.ConditionsPret}" />
            <Label Text="{Binding Objet.Bati}" Style="{StaticResource SousTitre}" />
            <Label Text="{Binding Objet.ProprietaireNom}" Style="{StaticResource SousTitre}" />
            <components:EtatErreurView IsVisible="{Binding AErreur}" Message="{Binding MessageErreur}" />
            <Button Text="Demander le pret" Style="{StaticResource BoutonPrimaire}" Command="{Binding DemanderPretCommand}" />
            <Button Text="Retour" Command="{Binding RetourCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
