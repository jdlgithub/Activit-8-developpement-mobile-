<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:CampusShare.Backend.Contracts.Dtos;assembly=CampusShare.Backend"
             x:Class="CampusShare.Frontend.Views.Components.CarteObjetView"
             x:DataType="dtos:ObjetDTO">
    <Border Style="{StaticResource Carte}" Margin="0,6">
        <VerticalStackLayout Spacing="4">
            <Label Text="{Binding Titre}" FontAttributes="Bold" />
            <Label Text="{Binding Categorie}" TextColor="{StaticResource Gray500}" />
            <Label Text="{Binding ProprietaireNom}" TextColor="{StaticResource Gray500}" />
            <Button Text="Voir la fiche"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConsulterCommand}"
                    CommandParameter="{Binding .}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
