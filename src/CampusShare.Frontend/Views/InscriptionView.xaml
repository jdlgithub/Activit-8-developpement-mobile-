<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusShare.Frontend.Views.InscriptionView"
             Title="Inscription">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="{Binding Titre}" Style="{StaticResource TitreEcran}" />
            <Entry Placeholder="Prenom" Text="{Binding Prenom}" />
            <Entry Placeholder="Nom" Text="{Binding Nom}" />
            <Entry Placeholder="Email universitaire" Text="{Binding Email}" Keyboard="Email" />
            <Entry Placeholder="Mot de passe" Text="{Binding MotDePasse}" IsPassword="True" />
            <Entry Placeholder="Filiere" Text="{Binding Filiere}" />
            <Entry Placeholder="Niveau d etudes" Text="{Binding NiveauEtudes}" />
            <Button Text="Creer un compte" Style="{StaticResource BoutonPrimaire}" Command="{Binding ValiderCommand}" />
            <Button Text="Retour" Command="{Binding RetourCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
