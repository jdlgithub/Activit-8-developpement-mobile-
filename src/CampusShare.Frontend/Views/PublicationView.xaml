<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusShare.Frontend.Views.PublicationView"
             Title="Publication">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="{Binding Titre}" Style="{StaticResource TitreEcran}" />
            <Entry Placeholder="Titre de l objet" Text="{Binding TitreObjet}" />
            <Entry Placeholder="Categorie" Text="{Binding Categorie}" />
            <Editor Placeholder="Description" Text="{Binding Description}" HeightRequest="80" />
            <Editor Placeholder="Conditions de pret" Text="{Binding ConditionsPret}" HeightRequest="60" />
            <Entry Placeholder="Batiment et salle" Text="{Binding Bati}" />
            <Button Text="Publier" Style="{StaticResource BoutonPrimaire}" Command="{Binding PublierCommand}" />
            <Button Text="Retour" Command="{Binding RetourCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
