<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:CampusShare.Frontend.Views.Components"
             x:Class="CampusShare.Frontend.Views.TableauDeBordView"
             Title="Tableau de bord">
    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="{Binding Titre}" Style="{StaticResource TitreEcran}" />
            <SearchBar Placeholder="Rechercher un objet" Text="{Binding Recherche}" SearchCommand="{Binding ChargerCommand}" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Publier" Style="{StaticResource BoutonPrimaire}" Command="{Binding PublierCommand}" />
                <Button Text="Profil" Style="{StaticResource BoutonSecondaire}" Command="{Binding ProfilCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <Grid Grid.Row="1">
            <CollectionView ItemsSource="{Binding Objets}" IsVisible="{Binding ListeVisible}">
                <CollectionView.EmptyView>
                    <components:EtatVideView Message="Aucun objet ne correspond a votre recherche." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <components:CarteObjetView />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <components:EtatErreurView IsVisible="{Binding AErreur}"
                                       Message="{Binding MessageErreur}"
                                       VerticalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>
