<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusShare.Frontend.Views.MotDePasseOublieView"
             Title="Mot de passe oublie">
    <VerticalStackLayout Padding="24" Spacing="14">
        <Label Text="{Binding Titre}" Style="{StaticResource TitreEcran}" />
        <Entry Placeholder="Email universitaire" Text="{Binding Email}" Keyboard="Email" />
        <Button Text="Envoyer le lien" Style="{StaticResource BoutonPrimaire}" Command="{Binding EnvoyerCommand}" />
        <Button Text="Retour" Command="{Binding RetourCommand}" />
    </VerticalStackLayout>
</ContentPage>
